{
  "name": "@lunya/sdk",
  "version": "0.1.0-alpha.2",
  "description": "TypeScript SDK for the Lunya exchange and launchpad. Framework-agnostic; viem for transport.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunyaio/sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/lunyaio/sdk#readme",
  "bugs": {
    "url": "https://github.com/lunyaio/sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dex": {
      "types": "./dist/dex/index.d.ts",
      "default": "./dist/dex/index.js"
    },
    "./launchpad": {
      "types": "./dist/launchpad/index.d.ts",
      "default": "./dist/launchpad/index.js"
    },
    "./abis": {
      "types": "./dist/generated/abis.d.ts",
      "default": "./dist/generated/abis.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-out/**/*.test.js\"",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "viem": "^2.55.5",
    "@types/node": "^22.10.2"
  },
  "keywords": [
    "lunya",
    "dex",
    "launchpad",
    "defi",
    "viem",
    "evm"
  ]
}
