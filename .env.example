# Copy to .env and fill in. `.env` is gitignored; this file is not, and must
# never grow a real value.
#
#     cp .env.example .env
#
# Everything here is read by `deploymentFromEnv()`, and only when you call it —
# nothing else in this package touches the environment. Anything exported in
# your shell wins over this file.

# ---------------------------------------------------------------- which chain

# A chain id. Leave it unset to let the caller pass "testnet" / "mainnet"
# instead: the shipped registry supplies the rest of the chain metadata — name,
# native coin, explorer — which these variables would only duplicate and get
# wrong.
LUNYA_CHAIN_ID=

# Optional. Overrides the shipped public endpoint, which rate-limits and should
# not be leaned on by anything running in a loop.
LUNYA_RPC_URL=

# ------------------------------------------------------------------ addresses

# OPTIONAL. The package ships the addresses of every network it lists; leave
# these empty to use them. Each one set overrides the shipped value — for a
# fork, your own deployment, or contracts newer than your installed version.

# To quote or swap.
LUNYA_DEX_FACTORY=
LUNYA_DEX_POOL_DEPLOYER=
LUNYA_DEX_SWAP_ROUTER=
LUNYA_DEX_QUOTER=

# To trade the bonding curve. This is the FACTORY that clones launches, not a
# launch: a launch is its own contract, and its address comes from the factory
# or from the token it sells via `getLaunchByToken`.
LUNYA_LAUNCH_FACTORY=

# Optional. The default routing hub — what pairs are looked for against when no
# direct pool exists. Usually the chain's own pair token, which the registry
# already knows.
LUNYA_PAIR_TOKEN=

# Optional. Where an indexer following these contracts should start.
LUNYA_DEX_START_BLOCK=
LUNYA_LAUNCH_START_BLOCK=

# ------------------------------------------------------------------- examples

# Read by the examples in this repository, never by the package.
#
# "testnet", "mainnet", or a chain id. Overridden by LUNYA_CHAIN_ID above.
LUNYA_NETWORK=

# Comma-separated addresses. Pool discovery starts from a token universe, and
# this is the one the examples use; supply the tokens you actually track.
LUNYA_TOKENS=

# THERE IS NO PRIVATE KEY HERE, and there will not be. This package never signs
# anything: every write returns an unsigned { to, data, value } for whatever
# signer you already have. The one example that does send reads a key from the
# environment at the moment it runs —
#
#     LUNYA_PRIVATE_KEY=0x… pnpm --filter curve-bot start
#
# rather than from a file whose committed twin sits beside it under a name one
# character away. That is how keys leak.
